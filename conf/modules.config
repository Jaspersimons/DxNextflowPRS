/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {



    withName: FASTQC {
        ext.args = '--quiet'
    }
    withName: 'MULTIQC' {
        cpus   = 1
        memory = { 5.GB * task.attempt }
        time   = { 10.m * task.attempt }
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: GET_PGSC_SNPLIST {
        storeDir = "${params.cache_dir}/snp_list"
        time   = 5.m
        memory = 5.GB 
        cpus   = 1
    }

    withName: GET_PGSC_VCF {
        storeDir = "${params.cache_dir}/PRS_vcf"
        time   = 5.m
        memory = 5.GB 
        cpus   = 1
    }

    withName: PGS_NORM {
        cpus   = 1
        memory = { 3.GB * task.attempt }
        time   = { 10.m * task.attempt }

        publishDir = [
            path: { "${params.outdir}/PGS_score" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

   withName: PLINK2_VCF {
        cpus     = 2
        memory   = { 10.GB * task.attempt }
        time     = { 30.m * task.attempt }
        ext.args = { 
            [
                "--allow-extra-chr",
                "--chr 1-22,X,Y,XY",
                "--make-pgen vzs pvar-cols='-xheader,-maybequal,-maybefilter,-maybeinfo,-maybecm'",
                "--missing vcols=fmissdosage,fmiss",
                "--freq",
                "--set-all-var-ids '@:#:\$r:\$a'"
            ].join(' ').trim() 
        }
    }


   withName: PLINK2_SCORE {
        cpus     = 2
        memory   = { 10.GB * task.attempt }
        time     = { 30.m * task.attempt }
    }


    withName: GATK4_HAPLOTYPECALLER {
        cpus   = 2
        memory = { 15.GB * task.attempt }
        time   = { 2.h * task.attempt }
        array  = 100
        ext.prefix = { "${meta.id}_${meta.chr}.g" }
    }

    withName: BCFTOOLS_MERGE {
        cpus   = 4
        memory = { 15.GB * task.attempt }
        time   = { 30.m * task.attempt }

        ext.args = "--output-type z --write-index=tbi"
        ext.prefix = {"${meta.id}_bcfmerge"}
    }

    withName: REPLACE_INF_VCF {
        cpus = 1
        memory = { 10.GB * task.attempt }
        time   = { 10.m * task.attempt }

        publishDir {
            path = "${params.outdir}/vcf_files/bcftools"
            mode = params.publish_dir_mode
            saveAs = { filename -> filename.equals('versions.yml') ? null : filename }

        }
    }

    withName: PGSCATALOG_MATCH {
        cpus = 2
        memory = { 5.GB * task.attempt}
        time = { 10.m * task.attempt }
        ext.args = {"--min_overlap 0.75"}
     }

    withName: PGSCATALOG_COMBINE {
        storeDir = "${params.cache_dir}/combine"
        cpus = 2
        memory = { 5.GB * task.attempt }
        time = { 10.m * task.attempt }
    }



}
