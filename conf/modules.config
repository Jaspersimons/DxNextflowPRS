/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


   withName: PLINK2_VCF {
        cpus     = 6
        memory   = { 20.GB * task.attempt * 1.5}
        time     = { 30.m * task.attempt }
        ext.args = { "--allow-extra-chr --chr 1-22, X, Y, XY --make-pgen" }
    }


    withName: GATK4_HAPLOTYPECALLER {
        cpus   = 6
        memory = { 15.GB * task.attempt }
        time   = { 30.m * task.attempt }

        ext.args   = "-ERC BP_RESOLUTION"
        ext.prefix = { "${meta.id}.g" }

        publishDir {
            path = "${params.outdir}/gatk4/haplotypecaller"
            mode = params.publish_dir_mode
            saveAs = { filename ->  filename.equals('versions.yml') ? null : filename }

        }
    }

    withName: GATK4_COMBINEGVCFS {
        cpus = 2
        memory = { 15.GB * task.attempt }
        time   = { 10.m * task.attempt }


        publishDir {
            path = "${params.outdir}/gatk4/merged"
            mode = params.publish_dir_mode
            saveAs = { filename ->  filename.equals('versions.yml') ? null : filename }

        }
    }

    withName: GATK4_GENOTYPEGVCFS {
        cpus   = 2
        memory = { 15.GB * task.attempt }
        time   = { 30.m * task.attempt }

        errorStrategy = "terminate"

        ext.args = "--include-non-variant-sites true"


        publishDir {
            path = "${params.outdir}/gatk4/genotypes"
            mode = params.publish_dir_mode
            saveAs = { filename ->  filename.equals('versions.yml') ? null : filename }

        }
    }

    withName: BCFTOOLS_MERGE {
        cpus   = 4
        memory = { 15.GB * task.attempt }
        time   = { 30.m * task.attempt }

        ext.args = "--output-type z --write-index=tbi"
        ext.prefix = {"${meta.id}_bcfmerge"}

        publishDir {
            path = "${params.outdir}/vcf_files/bcftools"
            mode = params.publish_dir_mode
            saveAs = { filename -> filename.equals('versions.yml') ? null : filename }

        }
    }
    withName: BCFTOOLS_VIEW {
        cpus   = 2
        memory = { 10.GB * task.attempt }
        time   = { 10.m * task.attempt }

        ext.args  = "--write-index=tbi -Oz"
        ext.prefix= { "${meta.id}_subset" }
    }

    withName: REMOVE_CHR {
        cpus   = 2
        memory = { 10.GB * task.attempt }
        time   = { 10.m * task.attempt }

        ext.prefix = { "${meta.id}_nochr"  }
        ext.args = "--rename-chrs ${projectDir}/assets/chr_remove_table.txt --output-type z --write-index=tbi"
    }

    withName: ADD_CHR {
        cpus   = 2
        memory = { 10.GB * task.attempt }
        time   = { 10.m * task.attempt }

        ext.args = "--rename-chrs ${projectDir}/assets/chr_add_table.txt --output-type z --write-index=tbi"
    }


    withName: REPLACE_INF_VCF {
        cpus = 1
        memory = { 10.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }

    withName: GENERATE_SAMPLESHEET {
        cpus = 1
        memory = { 10.GB * task.attempt }
        time   = { 10.m * task.attempt }


        publishDir {
            path = "${params.outdir}/"
            mode = params.publish_dir_mode
            saveAs = { filename -> filename.equals('versions.yml') ? null : filename }

        }
    }

    withName: NEXTFLOW_RUN {
        cpus = 1
        memory = { 10.GB * task.attempt }
        time   = { 1.h * task.attempt }

        publishDir {
            path = "${params.outdir}/PRS"
            mode = params.publish_dir_mode
            saveAs = { filename -> filename.equals('versions.yml') ? null : filename }
        }
    }

    withName: BCFTOOLS_INDEX {
        cpus   = 1
        memory = { 10.GB * task.attempt }
        time   = {10.m * task.attempt}

        ext.args = {"--tbi"}
    }

}
