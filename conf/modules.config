/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

	withName: BCFTOOLS_MERGE {
		cpus = 4
		memory = { 15.GB * task.attempt }
		time = { 30.m * task.attempt }
		ext.args = "--output-type z --write-index=tbi"
		ext.prefix = { "${meta.id}_bcfmerge" }
	}

	withName: BCFTOOLS_SORT {
		cpus = 4
		memory = { 15.GB * task.attempt }
		time = { 30.m * task.attempt }
		ext.args = "--output-type z --write-index=tbi"
		ext.prefix = { "${meta.id}_sort" }
		storeDir = "${params.cache_dir}/snp_list"
	}

	withName: GET_PGSC_SNPLIST {
		cpus = 1
		memory = { 5.GB * task.attempt }
		time = { 5.m * task.attempt }
		storeDir = "${params.cache_dir}/snp_list"
	}

	withName: GATK4_HAPLOTYPECALLER {
		cpus = 2
		memory = { 5.GB * task.attempt }
		time = { 30.m * task.attempt }

        ext.args = {"-ERC GVCF"}

        publishDir = [
			path: { "${params.outdir}/vcf/haplotypecaller" },
			mode: params.publish_dir_mode,
			saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
		]
	}

	withName: GATK4_GENOTYPEGVCFS {
		cpus = 2
		memory = { 5.GB * task.attempt }
		time = { 30.m * task.attempt }

        ext.args = {"--include-non-variant-sites"}

        publishDir = [
			path: { "${params.outdir}/vcf/genotypegvcfs" },
			mode: params.publish_dir_mode,
			saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
		]
	}

	withName: GET_PGSC_VCF {
		cpus = 1
		memory = { 5.GB * task.attempt }
		time = { 5.m * task.attempt }
		storeDir = "${params.cache_dir}/PRS_vcf"
	}

	withName: MULTIQC {
		cpus = 1
		memory = { 5.GB * task.attempt }
		time = { 10.m * task.attempt }
		publishDir = [
			path: { "${params.outdir}/multiqc" },
			mode: params.publish_dir_mode,
			saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
		]
		ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
	}

	withName: PGSCATALOG_COMBINE {
		cpus = 2
		memory = { 5.GB * task.attempt }
		time = { 10.m * task.attempt }
		storeDir = "${params.cache_dir}/combine"
	}

	withName: PGSCATALOG_MATCH {
		cpus = 2
		memory = { 5.GB * task.attempt }
		time = { 10.m * task.attempt }
		ext.args = { "--min_overlap 0.75 --keep_ambiguous" }

        publishDir = [
            path: { "${params.outdir}/PGSCATALOG_MATCH" },
			mode: params.publish_dir_mode,
			saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
	}

	withName: PGS_NORM {
		cpus = 1
		memory = { 3.GB * task.attempt }
		time = { 10.m * task.attempt }
		publishDir = [
			
		]
	}

	withName: PLINK2_SCORE {
		cpus = 2
		memory = { 10.GB * task.attempt }
		time = { 30.m * task.attempt }
	}

	withName: PLINK2_VCF {
		cpus = 2
		memory = { 10.GB * task.attempt }
		time = { 30.m * task.attempt }
		ext.args = {
			[
				"--allow-extra-chr",
				"--chr 1-22,X,Y,XY",
				"--make-pgen vzs pvar-cols='-xheader,-maybequal,-maybefilter,-maybeinfo,-maybecm'",
				"--missing vcols=fmissdosage,fmiss",
				"--freq",
				"--set-all-var-ids '@:#:\$r:\$a'",
			].join(' ').trim()
		}
	}

	withName: REPLACE_INF_VCF {
		cpus = 1
		memory = { 10.GB * task.attempt }
		time = { 10.m * task.attempt }
		publishDir = [
			path: "${params.outdir}/vcf_files/bcftools",
			mode: params.publish_dir_mode,
			saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
		]
	}
}
