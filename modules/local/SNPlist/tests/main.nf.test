nextflow_process {
    name "Test Process SNPlist"
    script "../main.nf"
    process "GET_SNPLIST"


    tag "modules"
    tag "modules/local"
    tag "local"
    tag "normalisation"
    tag "modules/SNP_LIST"

    test("Test BCAC_313 SNP list") {

        when {
            process {
                """
                input[0] = [
                    [id: "BCAC_313"],
                    file("${projectDir}/assets/models/BCAC_313_PRS_GRCh38.txt", checkIfExists: true)
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.list).match() }
            )
        }
    }
}
