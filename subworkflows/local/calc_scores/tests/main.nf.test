nextflow_workflow {
    name "Test PRS score calculation"
    script "../main.nf"
    workflow "CALC_SCORES"
    


    tag "subworkflows"
    tag "subworkflows/local"
    tag "subworkflows/calc_scores"
    tag "local"

    test("Validate scoring workflow"){

        
        
        when {
            workflow {
            """
                input[0] = [[id: "vcf"], file("${projectDir}/assets/test-data/test.vcf", checkIfExists: true)]  //ch_vcf
                input[1] = [[id: "model"], file("${projectDir}/assets/test-data/norm_test_model_subworkflow.txt.gz", checkIfExists: true)]
            """
            }
        }
        then {
            assertAll (
                {assert workflow.success}
            )
        }
    }
}

