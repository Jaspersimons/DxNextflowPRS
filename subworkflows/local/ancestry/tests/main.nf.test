nextflow_workflow {
    name "Test Ancestry subworkflow"
    script "../main.nf"
    workflow "ANCESTRY"

    tag "subworkflows"
    tag "subworkflows/local"
    tag "ancestry"
    tag "local"

    test("Validate ancestry subworkflow") {

        when {
            workflow{
                """
                input[0] = Channel.of([
                    [id: 'test_sample'],
                    file("${projectDir}/assets/test-data/test_sample.vcf.gz", checkIfExists: true),
                    file("${projectDir}/assets/test-data/test_sample.vcf.gz.tbi", checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [id: 'test_ref'],
                    file("${projectDir}/assets/test-data/test_ref.vcf.gz", checkIfExists: true),
                    file("${projectDir}/assets/test-data/test_ref.vcf.gz.tbi", checkIfExists: true)
                ]).first()
                input[2] = Channel.of([
                    [id: 'ref_meta'],
                    file("${projectDir}/assets/test-data/test_ref_meta.psam", checkIfExists: true)
                ])
                input[3] = Channel.of([
                    [id: 'genome'],
                    file("genome.fasta") //dummy fasta
                ])
                input[4] = Channel.of([
                    [id: 'genome'],
                    file("genome.fasta.fai") //dummy fasta index
                ])
                """
            }
        }
        then{
            assertAll(
                { assert workflow.success }
            )
        }
    }
}
