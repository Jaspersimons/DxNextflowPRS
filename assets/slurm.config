params {
    cluster_options = "--account=diaggen"
}




profiles {

    slurm {
        process {
            executor = 'slurm'
            queue = 'cpu'
            clusterOptions = "$params.cluster_options"

            errorStrategy = 'retry'
            maxRetries = 0
        }

        apptainer.enabled = false
        singularity {
            enabled = true
            runOptions = '-B /hpc:/hpc -B $TMPDIR:$TMPDIR'
            autoMounts = true
            cacheDir = '/hpc/diaggen/software/singularity_cache/'
        }

        executor {
            queueSize = 1000
            pollInterval = '1min'
            queueStatInterval = '5min'
            submitRatelimit = '10sec'
        }

       mail {
            smtp.host = 'localhost'
        }
    }

    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g) '
    }

    singularity {
        singularity.enabled = true
        docker.enabled= false
        runOptions = '-B /hpc:/hpc -B $TMPDIR:$TMPDIR'
        autoMounts = true
        cacheDir = '/hpc/diaggen/software/singularity_cache/'
    }

    test {
        singularity.enagled = true
        docker.enabled = false
        runOptions = '-B /hpc:/hpc -B $TMPDIR:$TMPDIR'
        autoMounts = true
        cacheDir = '/hpc/diaggen/software/singularity_cache/'
        // includeConfig 'tests/nextflow.config'
    }
}
