{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "nf-core/prs pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "bam": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.bam$",
                "errorMessage": "BAM file"
            },
            "bai": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.bam.bai$",
                "errorMessage": "BAM index file"
            }
        },
        "required": ["sample", "bam", "bai"]
    }
}
