nextflow_pipeline{
    name "Test DxNextflowPRS stubbed"
    script "main.nf"

    tag "pipeline"
    tag "local"
    tag "pipeline/local"

    test("Run stubbed pipeline") {
        options "-stub-run"
        when{
            params {
                outdir = "$outputDir"
            }
        }
        then{
            assert workflow.success
            assert snapshot(file("$outputDir/pipeline_info/prs_software_mqc_versions.yml")).match("versions")
        }
    }
}
