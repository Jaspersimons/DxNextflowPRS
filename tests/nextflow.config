params {
    genome_fasta = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta"
    genome_dict = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.dict"
    dbsnp = "https://raw.githubusercontent.com/UMCUGenetics/DxNextflowTestData/main/DxNextflowPRS/dbsnp_v146_grch38_bcac_313.vcf.gz"

    outdir = "outdir"
    input  = "${projectDir}/assets/test-data/samplesheet.csv"
    assembly_version = "GRCh38"

}

process {
    executor      = 'local'
    queue         = 'cpu'

    withName: ".*" {
        cpus   = 1
        memory = 3.GB
        time   = 10.m
        
    }

    
	withName: PLINK2_VCF {
		ext.args = {
			[
				"--allow-extra-chr",
				"--chr 1-22,X,Y,XY",
				"--make-pgen vzs pvar-cols='-xheader,-maybequal,-maybefilter,-maybeinfo,-maybecm'",
				"--missing vcols=fmissdosage,fmiss",
				"--freq",
				"--set-all-var-ids '@:#:\$r:\$a'",
			].join(' ').trim()
		}
	}

}
