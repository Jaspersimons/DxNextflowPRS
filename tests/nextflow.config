params {

    modules_testdata_base_path = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/homo_sapiens/"
    outdir = 'results'

    // Input data
    // TODO nf-core: Specify the paths to your test data on nf-core/test-datasets
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    input  = "/hpc/diaggen/users/joris/software/DxNextflowPRS/assets/test-data/samplesheet.csv"
    genome_fasta = "${modules_testdata_base_path}/genome/genome.fasta"
    genome_dict  = "${modules_testdata_base_path}/genome/genome.dict"
    dbsnp = "${modules_testdata_base_path}/genome/vcf/dbsnp_146.hg38.vcf.gz"
    assembly_version = "GRCh38"

    custom_scoring = "/hpc/diaggen/users/joris/software/DxNextflowPRS/assets/test-data/test_model.txt"



}

// Impose sensible resource limits for testing
process {
    withName: '.*' {
        cpus   = 2
        memory = 3.GB
        time   = 2.h
    }
}

profiles {

    nftest {

        singularity.enabled = true
        docker.enabled      = false
        runOptions          = '-B /hpc:/hpc -B $TMPDIR:$TMPDIR'
        autoMounts          = true
        cacheDir            = '/hpc/diaggen/software/singularity_cache/'
    }

}
